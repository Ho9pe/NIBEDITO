# Copy to .env and fill in. Never commit the filled-in file.
#
# Values are written without surrounding quotes on purpose. dotenv strips them
# here, but hosting dashboards store them literally, so a quoted CLIENT_URL will
# never match the browser's origin and every CORS check will fail.

# --- server ---------------------------------------------------------------
SERVER_PORT=3001

# "development" locally, exactly "production" in a deployment. It decides
# whether auth cookies carry the Secure flag: https requires it, and setting it
# locally would stop the browser storing the cookie over plain http at all.
NODE_ENV=development

# Frontend origin. Matched exactly by CORS, so no trailing slash. Also used to
# build the links inside activation and password-reset emails.
CLIENT_URL=http://localhost:3000

# --- database -------------------------------------------------------------
# docker compose overrides this to point at its own mongo service.
MONGODB_ATLAS_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>

# --- auth -----------------------------------------------------------------
# Three different long random strings. Rotating any of these signs everyone out.
JWT_ACCESS_KEY=replace-with-a-long-random-string
JWT_REFRESH_KEY=replace-with-a-different-long-random-string
JWT_ACTIVATION_KEY=replace-with-a-third-long-random-string

# --- email ----------------------------------------------------------------
# Registration fails and the new account is deleted if the activation email
# cannot be sent, so these must work. docker compose points HOST/PORT at a local
# mail catcher instead, and nothing leaves your machine.
#
# Production uses Mailgun. The From address must belong to a domain verified
# there - a gmail.com address is refused at send time no matter how correct the
# credentials are. STORE_NAME below becomes the display name beside it.
SMTP_EMAIL=no-reply@yourdomain.com

# The relay login. On Mailgun this is the SMTP user you created under the
# domain, which is itself an address and is usually the same one as above -
# leave it unset and it falls back to SMTP_EMAIL. Set it when the two differ:
# to send as orders@ while authenticating as no-reply@, or on providers whose
# username is generated rather than an address (MailerSend, or Resend, where
# the username is the literal string "resend").
SMTP_USER=no-reply@yourdomain.com

# Mailgun: the SMTP user's password, not the account's API key. They are
# different credentials and the API key will not authenticate here.
SMTP_PASSWORD=the-smtp-users-password

# Optional. Defaults to smtp.gmail.com:587 when unset.
# Mailgun US region: smtp.mailgun.org  |  EU region: smtp.eu.mailgun.org
#
# 2525, not 587. Mailgun accepts 25, 465, 587 and 2525, but DigitalOcean blocks
# outbound 25, 465 and 587 on every droplet by default - an anti-spam measure,
# not something wrong with your account. The connection times out after seven
# seconds with ETIMEDOUT and no indication that the host is what refused it.
# 2525 is not on that list and carries the same STARTTLS traffic. Most cloud
# providers block the same three ports, so prefer 2525 anywhere but localhost.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=2525

# --- store identity -------------------------------------------------------
# Printed in the header of invoice PDFs. All optional - they fall back to
# "Nibedito", "Dhaka, Bangladesh", SMTP_EMAIL and an empty phone, so invoices
# still generate if you leave this block alone.
#
# STORE_NAME is also the display name on every outgoing email, so it is what
# recipients see in their inbox next to SMTP_EMAIL.
STORE_NAME=Nibedito
STORE_ADDRESS=123 Example Road, Dhaka 1207, Bangladesh
STORE_EMAIL=orders@example.com
STORE_PHONE=+880 1700 000000

# --- image storage --------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- defaults and seeding -------------------------------------------------
DEFAULT_USER_PICTURE=https://res.cloudinary.com/<cloud>/image/upload/<path>/avatar.png
DEFAULT_USER_PASSWORD=password-for-seeded-test-users

# Addresses for the three accounts src/scripts/seed/seedTestUsers.js creates.
# Optional - they default to verified@example.com and friends, which are fine
# for signing in but cannot receive anything. Point them at real or disposable
# inboxes you control to exercise password reset and email change.
TEST_VERIFIED_EMAIL=verified@example.com
TEST_UNVERIFIED_EMAIL=unverified@example.com
TEST_BANNED_EMAIL=banned@example.com

# Used by src/scripts/createDefaultAdmin.js to create the admin you sign in
# with at /admin-login.
#
# 11 digits beginning with 0, the same rule as a customer phone - both come from
# constants/validationRules.js. adminModel used to carry its own 10-digit copy,
# which meant a number written the normal way was valid for one and rejected for
# the other.
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=choose-a-strong-password
SUPER_ADMIN_PHONE=01700000000
