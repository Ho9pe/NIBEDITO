# Copy to .env.local and fill in. Never commit the filled-in file.
#
# NEXT_PUBLIC_* values are inlined into the client bundle when Next builds, not
# read at runtime. Changing any of them requires a rebuild, not a restart, and
# setting them as container environment variables at run time has no effect.

# API base URL, including the /api prefix.
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Cloudinary delivery base for product and profile images.
NEXT_PUBLIC_CLOUDINARY_URL=https://res.cloudinary.com/<cloud-name>

# Number the support widget opens a WhatsApp chat with, in international
# format without a leading + or spaces.
NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER=8801700000000
